{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "anniv",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],

  // workers.dev のサブドメインを無効にする。Cloudflare Access のポリシーは
  // anniv.gift/admin にしか掛からないため、*.workers.dev を開けたままにすると
  // 管理画面への迂回経路になる。
  "workers_dev": false,

  "observability": { "enabled": true },

  // 本番ドメイン。Custom Domain にすると Cloudflare がDNSレコードと証明書を自動管理する。
  // www は Worker まで通し、middleware.ts で apex へ 301 する（旧本番と同じ挙動）。
  "routes": [
    { "pattern": "anniv.gift", "custom_domain": true },
    { "pattern": "www.anniv.gift", "custom_domain": true }
  ],


  // html_handling は既定の "auto-trailing-slash" のまま使う。
  // これにより /contact.html は /contact へ 307 で飛ぶ。旧本番（Vercel）は 308 だったので
  // 恒久/一時の区別だけ差があるが、遷移先ページの canonical と sitemap が
  // 拡張子なしを指しているので正規化のシグナルは足りている。
  // （run_worker_first で Worker 側から 308 を返す案は、アセットが 200 で
  //   返ってしまい .html が重複コンテンツ化するため不採用。）
  // 旧本番（Vercel の cleanUrls）が /contact.html → /contact へ 308 で飛ばしており、
  // **拡張子なしが正規URL**としてインデックスされているため、同じ形に揃える。
  // ここを "none" にすると向きが逆転して既存の正規URLが変わってしまう。
  // not_found_handling は "none"（＝アセットに無ければWorkerへ渡す）。
  // /media 配下や /admin の SSR ルートと Astro の404はWorker側で処理する。
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "none"
  },


  // 記事本体。database_id は `wrangler d1 create anniv` の出力で置き換える。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "anniv",
      "database_id": "1c4a6082-0ef7-4acf-9b4e-71dfc4996038"
    }
  ],

  // 記事内の画像。
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "anniv-media"
    }
  ]
}
