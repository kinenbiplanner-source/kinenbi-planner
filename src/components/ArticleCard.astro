---
/**
 * 一覧・軸レール・関連記事で使う記事カード。
 *
 * variant="compact" は幅の狭い場所（記事ページ下部の関連記事）用。
 * 説明文を落として2行タイトル＋日付だけにする（.card-grid.is-related と対）。
 *
 * 見出しレベルは呼び出し側が決める。カードの上にある見出しが h1 なら 2、
 * 軸セクションの h2 の下に並ぶトップページなら 3。ここで固定にすると
 * ページによって見出しレベルが飛ぶ（アウトラインが壊れる）。
 */
import type { ArticleCard } from '../lib/db';
import { axisShort } from '../lib/axis';

interface Props {
  article: ArticleCard;
  variant?: 'grid' | 'compact';
  headingLevel?: 2 | 3;
}

const { article, variant = 'grid', headingLevel = 2 } = Astro.props;
const Title = `h${headingLevel}` as 'h2' | 'h3';

/** ISO文字列を JST の YYYY.MM.DD に。Worker のタイムゾーンに左右されないよう自前で組む。 */
function jstDate(iso: string): string {
  const t = new Date(iso);
  if (Number.isNaN(t.getTime())) return '';
  const jst = new Date(t.getTime() + 9 * 60 * 60 * 1000);
  const p = (n: number) => String(n).padStart(2, '0');
  return `${jst.getUTCFullYear()}.${p(jst.getUTCMonth() + 1)}.${p(jst.getUTCDate())}`;
}

const date = article.published_at ? jstDate(article.published_at) : '';
---

<a class:list={['card', { 'is-compact': variant === 'compact' }]} href={`/media/${article.slug}`}>
  {
    article.hero_image ? (
      <div class="card-thumb">
        <img src={`/media/img/${article.hero_image}`} alt="" loading="lazy" decoding="async" />
      </div>
    ) : (
      <div class="card-thumb is-empty">
        <span>Anniv</span>
      </div>
    )
  }
  <div class="card-body">
    <span class="card-axis">{axisShort(article.axis)}</span>
    <Title class="card-title">{article.title}</Title>
    {variant === 'grid' && <p class="card-desc">{article.description}</p>}
    {date && <time class="card-date" datetime={article.published_at}>{date}</time>}
  </div>
</a>
