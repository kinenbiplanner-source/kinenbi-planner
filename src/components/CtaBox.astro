---
/**
 * Anniv送客CTAブロック。
 *
 * 体裁とリンク先は `.claude/agents/reference/content-axis.md` の雛形に合わせて固定する
 * （label="無料相談・お問い合わせ" / https://anniv.gift/contact）。label が判定キーで、color 指定は無視する。
 * 可変にしてよいのはリード文1行だけ。効能保証・煽りはNG（article-style-guide 8章）。
 *
 * 見た目は article.css の .cta-box 系が持つ（本文中の :::box 版と同じ見た目にするため、
 * スコープ付き <style> ではなくグローバルCSSに寄せてある）。
 * クリック計測は MediaLayout の委譲リスナーが data-cta を拾う。ここでリスナーを持つと二重発火する。
 */
interface Props {
  lead?: string;
}

const {
  lead = '記念日の準備をまるごと任せたいなら、お問い合わせフォームから無料でご相談いただけます。予算や希望が固まっていない段階のご相談も受け付けています。',
} = Astro.props;
---

<aside class="cta-box">
  <p class="cta-label">無料相談・お問い合わせ</p>
  <div class="cta-lead"><p>{lead}</p></div>
  <div class="cta-actions">
    <a href="https://anniv.gift/contact" class="cta-btn" data-cta="form">無料で相談する</a>
    <a
      href="https://lin.ee/U4deTzi"
      class="cta-btn cta-btn-line"
      target="_blank"
      rel="noopener noreferrer"
      data-cta="line">LINEで相談する</a
    >
  </div>
</aside>
