---
/**
 * メディア配下（一覧・カテゴリ・記事）の共通外枠。
 *
 * CSSはここで一括 import する。ページ側で個別に読むと、記事とカテゴリで
 * 読み込み順が変わってカスケードがズレるため（tokens → base → media → article の順が正）。
 *
 * 計測スクリプトもここに1本だけ置く。CTAは記事本文（markdown.ts が出す .cta-box）と
 * コンポーネント（CtaBox.astro）と一覧末尾（.list-cta）の3か所に出るので、
 * それぞれにリスナーを付けると二重発火する。document への委譲で1本に寄せている。
 * イベントの定義は `メディア方針/計測設計.md` が SSOT。
 */
import BaseHead from '../components/BaseHead.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/media.css';
import '../styles/article.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  current?: 'media';
  /** 記事ページだけ true。一覧で進捗バーを出しても意味がない。 */
  showProgress?: boolean;
  /** 検索結果のように、インデックスさせたくないページで true。 */
  noindex?: boolean;
  /**
   * 記事ページだけ渡す。記事の slug。
   * これが入っているときだけ PV ビーコン（POST /api/pv）を撃つ。
   * 記事ページはエッジで60秒キャッシュされるのでサーバ側では数えられない。
   * 計測スクリプトはこのファイルに集約する方針なので、記事ページ側ではなくここに置く。
   */
  pvSlug?: string;
}

const {
  title,
  description,
  ogImage,
  ogType,
  current,
  showProgress = false,
  noindex = false,
  pvSlug,
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <BaseHead
      title={title}
      description={description}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
    />
    <slot name="head" />
  </head>
  <body>
    {showProgress && <div class="scroll-progress" id="scroll-progress"></div>}
    <Nav current={current} />
    <main class="page">
      <slot />
    </main>
    <Footer />

    <script is:inline>
      (function () {
        var bar = document.getElementById('scroll-progress');
        var nav = document.getElementById('navbar');
        // 進捗バーは「動き」そのものが目的なので、動きを嫌う設定では動かさない
        // （width 0 のまま＝実質非表示）。ナビの影は状態表示なので残す。
        var reduce =
          window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var ticking = false;

        function paint() {
          ticking = false;
          var y = window.scrollY || window.pageYOffset || 0;
          if (nav) {
            if (y > 10) nav.classList.add('scrolled');
            else nav.classList.remove('scrolled');
          }
          if (bar && !reduce) {
            var max = document.documentElement.scrollHeight - window.innerHeight;
            bar.style.width = (max > 0 ? (y / max) * 100 : 0) + '%';
          }
        }

        function onScroll() {
          if (ticking) return;
          ticking = true;
          window.requestAnimationFrame(paint);
        }

        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });
        paint();

        document.addEventListener('click', function (e) {
          var t = e.target;
          if (!t || !t.closest) return;

          var cta = t.closest('[data-cta]');
          if (cta) {
            var kind = cta.getAttribute('data-cta');
            // 計測設計.md 3章：イベント名＝行為、event_label＝発火場所。
            // 記事末・本文中・サイドバー・一覧末尾で同じイベント名を使い、labelで区別する。
            var label = cta.getAttribute('data-cta-label') || 'article_cta';
            if (typeof gtag === 'function') {
              if (kind === 'line') {
                gtag('event', 'line_add_click', {
                  event_category: 'conversion',
                  event_label: label,
                });
              } else {
                gtag('event', 'cta_click', {
                  event_category: 'engagement',
                  event_label: label,
                });
              }
            }
            if (typeof fbq === 'function') {
              fbq('track', kind === 'line' ? 'Contact' : 'Lead');
            }
            return;
          }

          // メディアTOP・カテゴリのサイドバー「更新を受け取る」。行き先ごとに分けて数える。
          // ここだけ label が発火場所ではなく行き先になる（links.html の links_click と同じ扱い）。
          var follow = t.closest('[data-follow]');
          if (follow) {
            if (typeof gtag === 'function') {
              gtag('event', 'follow_click', {
                event_category: 'engagement',
                event_label: follow.getAttribute('data-follow') || 'unknown',
              });
            }
            return;
          }

          // フッターのLINEアイコン。LPの index_footer と揃えて label だけ分ける。
          if (t.closest('.footer-social a[href*="lin.ee"]')) {
            if (typeof gtag === 'function') {
              gtag('event', 'line_add_click', {
                event_category: 'conversion',
                event_label: 'media_footer',
              });
            }
            if (typeof fbq === 'function') fbq('track', 'Contact');
          }
        });
      })();
    </script>

    {
      pvSlug && (
        <script is:inline define:vars={{ pvSlug }}>
          // ここは素のJSで書く。define:vars とテンプレートリテラル記法（波括弧＋バッククォート）は
          // 併用できず、後者がそのまま文字列として出力されてJSとして壊れる。
          (function () {
            // 記事ページは s-maxage=60 でエッジにキャッシュされるため、
            // サーバのレンダリング回数＝閲覧数にならない。クライアントから1回だけ送る。
            // 二重に読み込まれても加算しないようフラグで守る（bfcache 復帰では再実行されない）。
            if (window.__annivPvSent) return;
            window.__annivPvSent = true;
            var body = JSON.stringify({ slug: pvSlug });
            try {
              if (navigator.sendBeacon) {
                navigator.sendBeacon('/api/pv', body);
              } else {
                fetch('/api/pv', { method: 'POST', keepalive: true, body: body });
              }
            } catch (e) {
              // PVが1件落ちるだけなので、記事の表示は止めない
            }
          })();
        </script>
      )
    }

    {/*
      自前計測（/api/ev）。上の /api/pv とは役割が違う：
      あちらは「記事ごとのPV」（pageviews テーブル・/admin/stats 用）、
      こちらは「導線のイベントを流入元つきで数える」（event_daily・/dashboard 用）。
      両方が page_view 相当を持つので数は一致しない。**突き合わせない**。

      メディア側は data-cta / data-follow を track.js がそのまま拾うので、
      このファイルのマークアップにも上の gtag リスナーにも手を入れていない。
      同じクリックで GA4 と自前に1件ずつ飛ぶのが意図した動き。
    */}
    <script is:inline src="/assets/track.js" defer></script>
  </body>
</html>
