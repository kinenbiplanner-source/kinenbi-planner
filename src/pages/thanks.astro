  <script is:inline>
    /*
      LINE への遷移を計測する。イベント名・label は従来どおり line_add_click / thanks。
      oaMessage リンクは lin.ee ではなく line.me なので、セレクタは両方見る
      （data-ev を付けておけば track.js 側の委譲リスナーが1件だけ送る）。
    */
    document.querySelectorAll('a[href*="lin.ee"], a[href*="line.me"]').forEach(function (el) {
      el.setAttribute('data-ev', 'line_add_click');
      el.setAttribute('data-ev-label', 'thanks');
      el.addEventListener('click', function () {
        if (typeof gtag === 'function') {
          gtag('event', 'line_add_click', { event_category: 'conversion', event_label: 'thanks' });
        }
        if (typeof fbq === 'function') {
          fbq('track', 'Contact');
        }
      });
    });

    /*
      受付番号のコピー。

      **同期版（execCommand）を先に走らせる。** LINE ボタンからも呼ぶが、あちらは
      コピーした直後にページを離れる。clipboard API は非同期なので、遷移が先に始まると
      書き込みが間に合わないことがある。execCommand はクリックのハンドラ内で
      同期的に終わるので、離脱に巻き込まれない。
      新しい API の方も撃っておく（execCommand が効かない環境の保険）。
    */
    function copyCode(code) {
      var ok = false;
      try {
        var ta = document.createElement('textarea');
        ta.value = code;
        ta.setAttribute('readonly', '');
        ta.style.position = 'fixed';
        ta.style.top = '0';
        ta.style.left = '-9999px';
        document.body.appendChild(ta);
        ta.select();
        ta.setSelectionRange(0, code.length); // iOS は select() だけだと選択されない
        ok = document.execCommand('copy');
        document.body.removeChild(ta);
      } catch (e) {
        ok = false;
      }
      try {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(code);
          ok = true;
        }
      } catch (e) {
        /* 失敗しても画面には番号が出ているので手で写せる */
      }
      return ok;
    }

    (function () {
      var btn = document.getElementById('codeCopy');
      if (!btn) return;
      btn.addEventListener('click', function () {
        var ok = copyCode(btn.getAttribute('data-code') || '');
        btn.textContent = ok ? 'コピーしました' : '手動でコピーしてください';
        setTimeout(function () { btn.textContent = '受付番号をコピー'; }, 2000);
      });
    })();

    /*
      LINE ボタンを押した瞬間に受付番号をコピーしておく。

      スマホではボタンを押すとアプリへ切り替わり、この画面には戻ってこない。
      番号を控えないまま LINE に行くと、トークで何を送ればいいか分からなくなる。
      **preventDefault はしない**——ユニバーサルリンクの遷移はブラウザに任せ、
      その手前で同期的にコピーだけ済ませる。
    */
    (function () {
      var line = document.getElementById('lineBtn');
      if (!line) return;
      var code = line.getAttribute('data-code') || '';
      if (!code) return;
      line.addEventListener('click', function () {
        copyCode(code);
      });
    })();

    /*
      アプリ内ブラウザの検知。

      Instagram・X・Facebook・TikTok のアプリ内ブラウザは、LINE のユニバーサルリンクを
      開かずに握りつぶすことがある。Anniv の流入はSNS中心なので、当たったときに
      「詰んだ」で終わらないよう、外部ブラウザで開き直す案内を出す。
      LINE 自身のブラウザは素通し（そこからは確実に開くため）。
    */
    (function () {
      var note = document.getElementById('inappNote');
      if (!note) return;
      var ua = navigator.userAgent || '';
      if (/\bLine\//i.test(ua)) return;
      var inApp = /Instagram|FBAN|FBAV|FB_IAB|Twitter|TikTok|Snapchat/i.test(ua);
      if (inApp) note.hidden = false;
    })();
  </script>
  <script is:inline src="/assets/track.js" defer></script>
</body>
</html>
