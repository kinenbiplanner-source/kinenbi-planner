---
/**
 * 記事エディタ（/admin/new）。
 *
 * このファイルは新規作成ページであると同時に、編集ページ（/admin/[id]/edit）の
 * 実体でもある。`article` プロップが渡されればそちらのモードで描く。
 *
 * 新しいコンポーネントファイルを増やさない制約の中で、
 * 400行超のフォームとエディタのスクリプトを2つのページに写経すると
 * 必ず片方だけ直して壊す。編集側から `import Editor from '../new.astro'` して
 * 差分をプロップ1つに閉じ込めるのが、この制約下でいちばん破綻しない形だと判断した。
 *
 * 画面の作り：
 *   1. article.md の貼り付け取り込み（frontmatter のパースは /api/preview の mode:'import'）
 *   2. メタ情報（slug / title / description / keyword / 軸 / ファネル / 状態 / PR / ヒーロー画像）
 *   3. 2ペイン（Markdown / プレビュー）。プレビューは保存時と同じ renderArticle を通す
 *   4. 保存バー（下書き保存 / 公開する）
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
import { AXES, FUNNELS } from '../../lib/axis';
import type { ArticleRow } from '../../lib/db';

export const prerender = false;

interface Props {
  /** 渡されれば編集モード。ページとして開かれたときは undefined（新規モード）。 */
  article?: ArticleRow | null;
}

const { article = null } = Astro.props;
const isEdit = article !== null;

// クライアント側スクリプトへ渡すのはモードとIDだけ。
// 初期値はフォームの value / textarea に直接埋めてあるので、
// 同じデータをJSONでも配って二重管理にならないようにする。
const boot = JSON.stringify({ mode: isEdit ? 'edit' : 'new', id: article?.id ?? null }).replace(
  /</g,
  '\\u003c',
);
---

<AdminLayout title={isEdit ? '記事を編集' : '新規作成'} current={isEdit ? 'edit' : 'new'}>
  <script id="editor-boot" type="application/json" is:inline set:html={boot} />

  <div class="admin-bar">
    <h1 class="admin-title">{isEdit ? '記事を編集' : '新規作成'}</h1>
    <a class="btn" href="/admin">一覧へ戻る</a>
    {
      isEdit && article.status === 'published' && (
        <a class="btn" href={`/media/${article.slug}`} target="_blank" rel="noopener noreferrer">
          公開ページ
        </a>
      )
    }
    {isEdit && <button class="btn btn-danger" type="button" id="btn-delete">削除</button>}
  </div>

  <div class="notice notice-error" id="msg-error" hidden></div>
  <div class="notice notice-warn" id="msg-warn" hidden></div>

  <div class="notice notice-info" id="msg-restore" hidden>
    <div>保存されていない編集内容がこのブラウザに残っています。復元しますか？</div>
    <div class="notice-actions">
      <button class="btn btn-sm btn-primary" type="button" id="restore-yes">復元する</button>
      <button class="btn btn-sm" type="button" id="restore-no">破棄する</button>
    </div>
  </div>

  {/* ── 1. article.md の取り込み ── */}
  <div class="admin-card import-area">
    <div class="admin-card-head">
      article.md を貼り付けて取り込む
      <span class="admin-hint">frontmatter があればメタ情報も自動で埋まる</span>
    </div>
    <div class="admin-card-body">
      <textarea
        id="import-src"
        placeholder="--- で始まる article.md をまるごと貼り付け（本文だけでも可）"></textarea>
      <div class="import-actions">
        <button class="btn btn-primary" type="button" id="import-run">取り込む</button>
        <span class="admin-hint" id="import-note">
          slug は自動生成しない。取り込み後に自分で決めること。
        </span>
      </div>
    </div>
  </div>

  {/* ── 2. メタ情報 ── */}
  <div class="admin-card">
    <div class="admin-card-head">メタ情報</div>
    <div class="admin-card-body">
      <div class="field-grid">
        <div class="field">
          <label for="f-slug">slug<span class="req">*</span></label>
          <input
            type="text"
            id="f-slug"
            class="mono"
            value={article?.slug ?? ''}
            placeholder="kinenbi-present-30dai"
            autocomplete="off"
            spellcheck="false"
          />
          <p class="field-note" id="slug-note">
            公開URLは /media/&lt;slug&gt;。半角英数とハイフンのみ、80字以内。
          </p>
        </div>

        <div class="field">
          <label for="f-keyword">ターゲットKW<span class="req">*</span></label>
          <input type="text" id="f-keyword" value={article?.keyword ?? ''} autocomplete="off" />
          <p class="field-note">KWマスターDBのKW列に出る値。</p>
        </div>

        <div class="field">
          <label for="f-axis">軸<span class="req">*</span></label>
          <select id="f-axis">
            {
              AXES.map((a) => (
                <option value={a.slug} selected={article?.axis === a.slug}>
                  {a.name}
                </option>
              ))
            }
          </select>
        </div>

        <div class="field">
          <label for="f-funnel">ファネル層<span class="req">*</span></label>
          <select id="f-funnel">
            {
              FUNNELS.map((f) => (
                <option value={f} selected={article?.funnel === f}>
                  {f}
                </option>
              ))
            }
          </select>
        </div>

        <div class="field">
          <label for="f-status">状態</label>
          <select id="f-status">
            <option value="draft" selected={article?.status !== 'published'}>下書き</option>
            <option value="published" selected={article?.status === 'published'}>公開</option>
          </select>
          <p class="field-note">下の保存ボタンでも切り替わる。</p>
        </div>

        <div class="field">
          <span class="field-label">PR表記</span>
          <label class="checkbox">
            <input type="checkbox" id="f-is-ad" checked={article?.is_ad === 1} />
            アフィリエイト・タイアップ記事（PR表記を出す）
          </label>
        </div>
      </div>

      <div class="field">
        <label for="f-title">タイトル<span class="req">*</span></label>
        <input type="text" id="f-title" value={article?.title ?? ''} autocomplete="off" />
      </div>

      <div class="field">
        <label for="f-description">ディスクリプション<span class="req">*</span></label>
        <textarea id="f-description" rows="2">{article?.description ?? ''}</textarea>
        <p class="field-note" id="desc-note">目安は120字前後（60〜140字）。</p>
      </div>

      <div class="field">
        <span class="field-label">ヒーロー画像</span>
        <div class="hero-box">
          <img class="hero-preview" id="hero-preview" alt="" hidden />
          <div class="hero-meta">
            <p class="hero-key" id="hero-key">未設定</p>
            <input type="hidden" id="f-hero" value={article?.hero_image ?? ''} />
            <input type="file" id="hero-file" accept="image/jpeg,image/png,image/webp,image/avif" />
            <p class="field-note">JPEG / PNG / WebP / AVIF、8MBまで。</p>
            <button class="btn btn-sm btn-danger" type="button" id="hero-remove" hidden>
              画像を外す
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  {/* ── 3. 本文とプレビュー ── */}
  <div class="admin-card">
    <div class="admin-card-head">
      本文（Markdown）
      <span class="admin-hint">記法は article-style-guide.md 9章。プレビューは本番と同じレンダラー</span>
    </div>
    <div class="admin-card-body">
      <div class="pane-tabs" role="tablist">
        <button class="pane-tab" type="button" id="tab-edit" role="tab" aria-selected="true">
          編集
        </button>
        <button class="pane-tab" type="button" id="tab-preview" role="tab" aria-selected="false">
          プレビュー
        </button>
      </div>

      <div class="panes" id="panes" data-tab="edit">
        <div class="pane" data-pane="edit">
          <div class="pane-head">Markdown</div>
          <textarea id="f-body" class="editor" spellcheck="false">{article?.body_md ?? ''}</textarea>
        </div>
        {/* 900px以下でどちらを見せるかは .panes[data-tab] とCSSが決める */}
        <div class="pane" data-pane="preview">
          <div class="pane-head">
            プレビュー
            <span class="admin-hint" id="preview-state"></span>
          </div>
          <div class="preview">
            {
              isEdit ? (
                <div class="prose" id="preview-body" set:html={article.body_html} />
              ) : (
                <div class="prose" id="preview-body">
                  <p class="preview-empty">本文を入力するとここに表示される。</p>
                </div>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </div>

  {/* ── 4. 保存 ── */}
  <div class="save-bar">
    <span class="save-state" id="save-state"></span>
    <span class="spacer"></span>
    <button class="btn" type="button" id="btn-save-draft">下書き保存</button>
    <button class="btn btn-primary" type="button" id="btn-save-publish">公開する</button>
  </div>
</AdminLayout>

<script>
  /* 記事エディタのクライアント側。新規・編集の両モードで同じコードが動く。 */

  interface Boot {
    mode: 'new' | 'edit';
    id: number | null;
  }
  interface Payload {
    slug: string;
    title: string;
    description: string;
    keyword: string;
    axis: string;
    funnel: string;
    status: string;
    body_md: string;
    hero_image: string;
    is_ad: boolean;
  }

  const bootEl = document.getElementById('editor-boot');
  const boot: Boot = bootEl?.textContent
    ? (JSON.parse(bootEl.textContent) as Boot)
    : { mode: 'new', id: null };

  // 制約を HTMLElement にすると HTMLSelectElement の remove() のオーバーロードと
  // 衝突して型エラーになるので、素の型引数にしている。
  function el<T>(id: string): T | null {
    return document.getElementById(id) as T | null;
  }

  const fSlug = el<HTMLInputElement>('f-slug')!;
  const fTitle = el<HTMLInputElement>('f-title')!;
  const fDesc = el<HTMLTextAreaElement>('f-description')!;
  const fKeyword = el<HTMLInputElement>('f-keyword')!;
  const fAxis = el<HTMLSelectElement>('f-axis')!;
  const fFunnel = el<HTMLSelectElement>('f-funnel')!;
  const fStatus = el<HTMLSelectElement>('f-status')!;
  const fIsAd = el<HTMLInputElement>('f-is-ad')!;
  const fBody = el<HTMLTextAreaElement>('f-body')!;
  const fHero = el<HTMLInputElement>('f-hero')!;

  const heroPreview = el<HTMLImageElement>('hero-preview')!;
  const heroKey = el<HTMLElement>('hero-key')!;
  const heroFile = el<HTMLInputElement>('hero-file')!;
  const heroRemove = el<HTMLButtonElement>('hero-remove')!;

  const previewBody = el<HTMLElement>('preview-body')!;
  const previewState = el<HTMLElement>('preview-state')!;
  const slugNote = el<HTMLElement>('slug-note')!;
  const descNote = el<HTMLElement>('desc-note')!;
  const saveState = el<HTMLElement>('save-state')!;

  const msgError = el<HTMLElement>('msg-error')!;
  const msgWarn = el<HTMLElement>('msg-warn')!;
  const msgRestore = el<HTMLElement>('msg-restore')!;

  /* ── 表示ヘルパー ── */

  function show(node: HTMLElement, html: string) {
    node.innerHTML = html;
    node.hidden = false;
  }
  function hide(...nodes: HTMLElement[]) {
    for (const n of nodes) n.hidden = true;
  }
  function escapeHtml(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }
  /** 日本語は1文字＝1コードポイントで数える（サーバ側の警告判定と揃える）。 */
  const charCount = (s: string) => [...s].length;

  /* ── 現在の入力内容 ── */

  function collect(): Payload {
    return {
      slug: fSlug.value.trim(),
      title: fTitle.value.trim(),
      description: fDesc.value.trim(),
      keyword: fKeyword.value.trim(),
      axis: fAxis.value,
      funnel: fFunnel.value,
      status: fStatus.value,
      body_md: fBody.value,
      hero_image: fHero.value,
      is_ad: fIsAd.checked,
    };
  }

  function apply(p: Partial<Payload>) {
    if (p.slug !== undefined) fSlug.value = p.slug;
    if (p.title !== undefined) fTitle.value = p.title;
    if (p.description !== undefined) fDesc.value = p.description;
    if (p.keyword !== undefined) fKeyword.value = p.keyword;
    if (p.axis) fAxis.value = p.axis;
    if (p.funnel) fFunnel.value = p.funnel;
    if (p.status) fStatus.value = p.status;
    if (p.body_md !== undefined) fBody.value = p.body_md;
    if (p.hero_image !== undefined) setHero(p.hero_image);
    if (p.is_ad !== undefined) fIsAd.checked = p.is_ad;
  }

  /* ── ヒーロー画像 ── */

  function setHero(key: string) {
    fHero.value = key;
    if (key) {
      heroPreview.src = `/media/img/${key}`;
      heroPreview.hidden = false;
      heroKey.textContent = key;
      heroRemove.hidden = false;
    } else {
      heroPreview.removeAttribute('src');
      heroPreview.hidden = true;
      heroKey.textContent = '未設定';
      heroRemove.hidden = true;
    }
  }

  heroFile.addEventListener('change', async () => {
    const file = heroFile.files?.[0];
    if (!file) return;
    hide(msgError);
    heroKey.textContent = 'アップロード中…';
    const form = new FormData();
    form.append('file', file);
    try {
      const res = await fetch('/api/upload', { method: 'POST', body: form });
      const data = (await res.json()) as { key?: string; error?: string };
      if (!res.ok || !data.key) {
        show(msgError, escapeHtml(data.error ?? 'アップロードに失敗しました'));
        setHero(fHero.value);
        return;
      }
      setHero(data.key);
      queueAutosave();
    } catch {
      show(msgError, '通信に失敗しました');
      setHero(fHero.value);
    } finally {
      heroFile.value = '';
    }
  });

  heroRemove.addEventListener('click', () => {
    // R2 のオブジェクトは消さない（他の記事が参照している可能性があるため）。
    // ここで外すのは記事とキーの紐付けだけ。
    setHero('');
    queueAutosave();
  });

  /* ── 入力補助（slug形式・description字数）── */

  const SLUG_RE = /^[a-z0-9]+(?:-[a-z0-9]+)*$/;

  function validateSlug() {
    const v = fSlug.value.trim();
    if (!v) {
      fSlug.classList.remove('is-invalid');
      slugNote.className = 'field-note';
      slugNote.textContent = '公開URLは /media/<slug>。半角英数とハイフンのみ、80字以内。';
      return;
    }
    const ok = SLUG_RE.test(v) && v.length <= 80;
    fSlug.classList.toggle('is-invalid', !ok);
    slugNote.className = ok ? 'field-note' : 'field-note is-error';
    slugNote.textContent = ok
      ? `公開URL: https://anniv.gift/media/${v}`
      : '半角英数とハイフンのみ（先頭・末尾はハイフン不可、80字以内）';
  }

  function updateDescCount() {
    const n = charCount(fDesc.value.trim());
    const off = n > 0 && (n < 60 || n > 140);
    descNote.className = off ? 'field-note is-warn' : 'field-note';
    descNote.textContent = `${n}字 / 目安は120字前後（60〜140字）`;
  }

  /* ── プレビュー（400msデバウンス）── */

  let previewTimer: number | undefined;
  let previewSeq = 0;

  async function runPreview() {
    const seq = ++previewSeq;
    const source = fBody.value;
    if (!source.trim()) {
      previewBody.innerHTML = '<p class="preview-empty">本文を入力するとここに表示される。</p>';
      previewState.textContent = '';
      return;
    }
    previewState.textContent = '更新中…';
    try {
      const res = await fetch('/api/preview', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ body_md: source }),
      });
      // 打鍵が速いと応答が前後するので、最後に投げたものだけ反映する
      if (seq !== previewSeq) return;
      const data = (await res.json()) as { html?: string; imagePlaceholders?: number; error?: string };
      if (!res.ok || data.html === undefined) {
        previewState.textContent = data.error ?? 'プレビューに失敗';
        return;
      }
      previewBody.innerHTML = data.html;
      previewState.textContent = data.imagePlaceholders
        ? `画像プレースホルダー ${data.imagePlaceholders} 件`
        : '';
    } catch {
      if (seq === previewSeq) previewState.textContent = 'プレビューに失敗';
    }
  }

  function queuePreview() {
    window.clearTimeout(previewTimer);
    previewTimer = window.setTimeout(runPreview, 400);
  }

  /* ── localStorage への自動退避 ── */

  // 新規で保存した直後に編集モードへ移る（後述）ので let。移った先で
  // 'anniv:draft:new' に書き続けると、次に新規作成を開いたときに
  // 別記事の内容の復元を提案してしまう。
  let storageKey = boot.mode === 'edit' ? `anniv:draft:${boot.id}` : 'anniv:draft:new';
  let autosaveTimer: number | undefined;

  function queueAutosave() {
    window.clearTimeout(autosaveTimer);
    autosaveTimer = window.setTimeout(() => {
      try {
        localStorage.setItem(storageKey, JSON.stringify(collect()));
        saveState.textContent = '未保存の変更あり（このブラウザに退避済み）';
      } catch {
        // 容量超過などは黙って諦める。退避は保険であって本筋ではない。
      }
    }, 600);
  }

  function clearAutosave() {
    window.clearTimeout(autosaveTimer);
    try {
      localStorage.removeItem(storageKey);
    } catch {
      /* noop */
    }
  }

  /** 退避が残っていて、かつ今の内容と違うときだけ復元を提案する。 */
  function offerRestore() {
    let stored: Payload | null = null;
    try {
      const raw = localStorage.getItem(storageKey);
      stored = raw ? (JSON.parse(raw) as Payload) : null;
    } catch {
      stored = null;
    }
    if (!stored) return;
    if (JSON.stringify(stored) === JSON.stringify(collect())) {
      clearAutosave();
      return;
    }
    msgRestore.hidden = false;
    el<HTMLButtonElement>('restore-yes')?.addEventListener('click', () => {
      apply(stored!);
      msgRestore.hidden = true;
      validateSlug();
      updateDescCount();
      runPreview();
    });
    el<HTMLButtonElement>('restore-no')?.addEventListener('click', () => {
      clearAutosave();
      msgRestore.hidden = true;
      saveState.textContent = '';
    });
  }

  /* ── article.md の取り込み ── */

  el<HTMLButtonElement>('import-run')?.addEventListener('click', async () => {
    const src = el<HTMLTextAreaElement>('import-src')!;
    const note = el<HTMLElement>('import-note')!;
    if (!src.value.trim()) {
      note.textContent = '貼り付けてから押すこと。';
      return;
    }
    note.textContent = '取り込み中…';
    try {
      // frontmatter のパースは lib/frontmatter.ts（サーバ側）が正。
      // 同じ処理をクライアントに書き写すと記法の解釈が二重管理になるので、
      // /api/preview の mode:'import' に投げてパース結果とHTMLを一度に受け取る。
      const res = await fetch('/api/preview', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ mode: 'import', body_md: src.value }),
      });
      const data = (await res.json()) as {
        parsed?: {
          title: string;
          description: string;
          keyword: string;
          axis: string | null;
          funnel: string | null;
          isAd: boolean;
          body: string;
          bodyOnly: boolean;
        };
        html?: string;
        error?: string;
      };
      if (!res.ok || !data.parsed) {
        note.textContent = data.error ?? '取り込みに失敗しました';
        return;
      }
      const p = data.parsed;
      apply({
        // frontmatter に無かった項目は今の入力を残す（上書きで消さない）
        title: p.title || fTitle.value,
        description: p.description || fDesc.value,
        keyword: p.keyword || fKeyword.value,
        ...(p.axis ? { axis: p.axis } : {}),
        ...(p.funnel ? { funnel: p.funnel } : {}),
        body_md: p.body,
        is_ad: p.isAd || fIsAd.checked,
      });
      if (data.html !== undefined) previewBody.innerHTML = data.html;
      validateSlug();
      updateDescCount();
      queueAutosave();
      note.textContent = p.bodyOnly
        ? 'frontmatter が無かったので本文だけ取り込んだ。メタ情報は手で埋めること。'
        : '取り込んだ。slug は自分で決めること。';
    } catch {
      note.textContent = '通信に失敗しました';
    }
  });

  /* ── タブ切替（900px以下）── */

  const tabEdit = el<HTMLButtonElement>('tab-edit')!;
  const tabPreview = el<HTMLButtonElement>('tab-preview')!;
  const panes = el<HTMLElement>('panes')!;

  // どちらのペインを見せるかは .panes[data-tab] を切り替えるだけにして、
  // 「900px以下のときだけ片方を隠す」判断は admin.css のメディアクエリに任せる。
  // JS で innerWidth を見て hidden を付け外しすると、リサイズや
  // 初期表示時の幅の取り違えで「片側が消えたまま戻らない」事故が起きる。
  function selectTab(which: 'edit' | 'preview') {
    panes.dataset.tab = which;
    tabEdit.setAttribute('aria-selected', String(which === 'edit'));
    tabPreview.setAttribute('aria-selected', String(which === 'preview'));
    if (which === 'preview') runPreview();
  }

  tabEdit.addEventListener('click', () => selectTab('edit'));
  tabPreview.addEventListener('click', () => selectTab('preview'));

  /* ── 保存 ── */

  const btnDraft = el<HTMLButtonElement>('btn-save-draft')!;
  const btnPublish = el<HTMLButtonElement>('btn-save-publish')!;

  async function save(status: 'draft' | 'published') {
    // 状態セレクトと保存ボタンは同じ値を指す。ボタンは「セレクトを切り替えて保存する」
    // ショートカットとして扱い、真の値は常にセレクト側に置く。
    fStatus.value = status;
    hide(msgError, msgWarn, msgRestore);

    const payload = collect();
    if (!SLUG_RE.test(payload.slug) || payload.slug.length > 80) {
      show(msgError, 'slug が不正です（半角英数とハイフンのみ、80字以内）');
      fSlug.focus();
      return;
    }

    btnDraft.disabled = true;
    btnPublish.disabled = true;
    saveState.textContent = '保存中…';

    const isNew = boot.mode === 'new';
    try {
      const res = await fetch(isNew ? '/api/articles' : `/api/articles/${boot.id}`, {
        method: isNew ? 'POST' : 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = (await res.json()) as { id?: number; warnings?: string[]; error?: string };

      if (!res.ok) {
        show(msgError, escapeHtml(data.error ?? '保存に失敗しました'));
        saveState.textContent = '';
        return;
      }

      clearAutosave();

      if (data.warnings && data.warnings.length) {
        // 警告があるときは一覧へ飛ばさない。飛ばすと警告を読む前に画面が消える。
        // 「保存は成功している」ことを明示した上で、その場で直せるようにする。
        if (isNew && data.id) {
          // 新規で作った直後にもう一度押されると slug 重複で 409 になるので、
          // ここで編集モードへ移す（URLも実体に合わせて書き換える）。
          boot.mode = 'edit';
          boot.id = data.id;
          storageKey = `anniv:draft:${data.id}`;
          history.replaceState(null, '', `/admin/${data.id}/edit`);
        }
        show(
          msgWarn,
          '<strong>保存は完了している</strong>が、公開前に確認したい点がある：<ul>' +
            data.warnings.map((w) => `<li>${escapeHtml(w)}</li>`).join('') +
            '</ul><div class="notice-actions"><a class="btn btn-sm" href="/admin">一覧へ戻る</a></div>',
        );
        saveState.textContent = '保存済み';
        return;
      }

      location.href = '/admin';
    } catch {
      show(msgError, '通信に失敗しました');
      saveState.textContent = '';
    } finally {
      btnDraft.disabled = false;
      btnPublish.disabled = false;
    }
  }

  btnDraft.addEventListener('click', () => save('draft'));
  btnPublish.addEventListener('click', () => save('published'));

  /* ── 削除（編集モードのみ）── */

  el<HTMLButtonElement>('btn-delete')?.addEventListener('click', async () => {
    if (!confirm('この記事を削除します。元に戻せません。よろしいですか？')) return;
    try {
      const res = await fetch(`/api/articles/${boot.id}`, { method: 'DELETE' });
      if (!res.ok) {
        const data = (await res.json()) as { error?: string };
        show(msgError, escapeHtml(data.error ?? '削除に失敗しました'));
        return;
      }
      clearAutosave();
      location.href = '/admin';
    } catch {
      show(msgError, '通信に失敗しました');
    }
  });

  /* ── 初期化 ── */

  fBody.addEventListener('input', () => {
    queuePreview();
    queueAutosave();
  });
  fSlug.addEventListener('input', () => {
    validateSlug();
    queueAutosave();
  });
  fDesc.addEventListener('input', () => {
    updateDescCount();
    queueAutosave();
  });
  for (const node of [fTitle, fKeyword, fAxis, fFunnel, fStatus, fIsAd]) {
    node.addEventListener('input', queueAutosave);
  }

  setHero(fHero.value);
  validateSlug();
  updateDescCount();
  offerRestore();
</script>
