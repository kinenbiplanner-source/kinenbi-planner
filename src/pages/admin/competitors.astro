    opacity: 0.55;
  }
  .cp-account-head {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .cp-handle {
    font-size: 14px;
    font-weight: 700;
    color: var(--navy);
    text-decoration: none;
  }
  .cp-handle:hover {
    text-decoration: underline;
  }
