    font-size: 10px;
    font-weight: 400;
    color: var(--text-light);
  }
  .cp-account-label {
    display: block;
    font-size: 11.5px;
    color: var(--text-light);
  }
  .cp-account-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px 12px;
