---
/**
 * メディア一覧の2ページ目以降。
 *
 * /media/page/1 は /media と中身が同じになるため 301 で寄せる（重複URL防止）。
 * 存在しないページ番号は 404。空ページをそのまま返すと薄いページが無限に増える。
 *
 * トップと違って軸レール・サイドバーは持たせない。2ページ目以降は
 * 「続きを読む人」しか来ないので、記事の一覧そのものだけを出す。
 */
export const prerender = false;

import MediaLayout from '../../../layouts/MediaLayout.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import { AXES } from '../../../lib/axis';
import { listPublished, countPublished, PAGE_SIZE } from '../../../lib/db';

const raw = Astro.params.n ?? '';
// 「01」「2.0」「-1」などを弾く。数値化できる文字列すべてを受けるとURLが増える。
if (!/^[1-9][0-9]*$/.test(raw)) return new Response('Not found', { status: 404 });

const page = Number(raw);
if (page === 1) return Astro.redirect('/media', 301);

const total = await countPublished();
const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
if (page > totalPages) return new Response('Not found', { status: 404 });

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=86400');

const articles = await listPublished({ limit: PAGE_SIZE, offset: (page - 1) * PAGE_SIZE });

const title = `記念日のヒント（${page}ページ目） | Anniv`;
const description =
  'プレゼント選びから記念日デートのお店選び、当日のサプライズ演出まで。記念日を成功させるための考え方と段取りをまとめた、Annivのメディアです。';

const hrefOf = (n: number) => (n === 1 ? '/media' : `/media/page/${n}`);

const SITE = 'https://anniv.gift';

/** トップ・カテゴリ・記事と揃える。2ページ目以降は /media の下という階層を明示する。 */
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Anniv', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'メディア', item: `${SITE}/media` },
    { '@type': 'ListItem', position: 3, name: `${page}ページ目`, item: `${SITE}/media/page/${page}` },
  ],
};
---

<MediaLayout title={title} description={description} current="media">
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)} />
  </Fragment>

  <div class="shell shell-media">
    <nav class="art-crumb" aria-label="パンくず">
      <a href="/">ホーム</a><span class="sep">›</span>
      <a href="/media">メディア</a><span class="sep">›</span>
      <span aria-current="page">{page}ページ目</span>
    </nav>

    <header class="section-header">
      <p class="section-label">MEDIA</p>
      <h1 class="section-title">記念日のヒント</h1>
      <p class="section-sub">
        プレゼント選びから当日の演出まで、記念日を成功させるための考え方をまとめています。
      </p>
    </header>

    <section class="findbar" aria-label="記事を探す">
      <form class="findbar-form" action="/media/search" method="get" role="search">
        <input
          class="findbar-input"
          type="search"
          name="q"
          placeholder="記念日、プレゼント、レストラン…"
          aria-label="記事を検索"
        />
        <button class="findbar-submit" type="submit">探す</button>
      </form>
      <div class="findbar-tags">
        <span class="findbar-tags-label">タグから探す</span>
        {
          AXES.map((a) => (
            <a class="findbar-tag is-axis" href={`/media/category/${a.slug}`}>
              {a.short}
            </a>
          ))
        }
      </div>
    </section>

    <nav class="axis-filter" aria-label="カテゴリ">
      <a class="axis-pill" href="/media" aria-current="page">すべて</a>
      {AXES.map((a) => <a class="axis-pill" href={`/media/category/${a.slug}`}>{a.name}</a>)}
    </nav>

    {
      articles.length === 0 ? (
        <p class="empty">記事は準備中です。</p>
      ) : (
        <div class="card-grid">
          {articles.map((a) => (
            <ArticleCard article={a} />
          ))}
        </div>
      )
    }

    <nav class="pager" aria-label="ページ送り">
      <a href={hrefOf(page - 1)}>前へ</a>
      {Array.from({ length: totalPages }, (_, i) => i + 1).map((n) =>
        n === page ? (
          <span class="is-current" aria-current="page">{n}</span>
        ) : (
          <a href={hrefOf(n)}>{n}</a>
        ),
      )}
      {
        page < totalPages ? (
          <a href={hrefOf(page + 1)}>次へ</a>
        ) : (
          <span class="is-disabled">次へ</span>
        )
      }
    </nav>

    <aside class="list-cta">
      <div>
        <p class="list-cta-title">記念日の準備に迷ったら</p>
        <p class="list-cta-text">
          プレゼント選び・お店の予約・当日の演出まで、まるごとご相談いただけます。予算や希望が固まっていない段階でも大丈夫です。
        </p>
      </div>
      <div class="list-cta-actions">
        <a href="https://anniv.gift/contact" class="cta-btn" data-cta="form" data-cta-label="media_list">無料で相談する</a>
        <a
          href="https://lin.ee/U4deTzi"
          class="cta-btn cta-btn-line"
          target="_blank"
          rel="noopener noreferrer"
          data-cta="line"
          data-cta-label="media_list">LINEで相談する</a
        >
      </div>
    </aside>
  </div>
</MediaLayout>
