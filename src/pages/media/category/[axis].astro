---
/**
 * 軸ごとの一覧。
 *
 * ページネーションは持たせない。1軸あたりの記事数が PAGE_SIZE を超えるのは当分先で、
 * 中身の薄い2ページ目を先に作っても内部リンクが散るだけなので、超えたときに
 * ここを「全件表示」に変える（メディア戦略.md の着手順どおり軸1から埋まっていく想定）。
 *
 * トップと同じ2カラム（本文＋サイドバー）にしてある。カテゴリは検索から直接
 * 着地する面なので、他の軸と人気記事への出口をここでも持たせておく。
 *
 * **記事が1本も無い軸は noindex**。中身が「準備中」だけのページを検索結果に出しても
 * 誰の役にも立たず、薄いページとして評価されるだけなので、記事が入るまでは伏せる
 * （sitemap.xml 側でも同じ条件で除外している）。
 */
export const prerender = false;

import MediaLayout from '../../../layouts/MediaLayout.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import { AXES, getAxis, isAxisSlug } from '../../../lib/axis';
import { listPublished, countPublished, listPopular, PAGE_SIZE } from '../../../lib/db';

const slug = Astro.params.axis ?? '';
if (!isAxisSlug(slug)) return new Response('Not found', { status: 404 });

const axis = getAxis(slug)!;

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=86400');

const SITE = 'https://anniv.gift';

const [articles, total, popularAll] = await Promise.all([
  listPublished({ axis: slug, limit: PAGE_SIZE }),
  countPublished(slug),
  listPopular(30, 5),
]);

// トップと同じ扱い。PVが付いていない記事を「人気」として並べない。
const popular = popularAll.filter((p) => p.pv > 0);

const title = `${axis.name} | Anniv`;
const description = `${axis.description}「${axis.name}」の記事一覧です。`;

const categoryUrl = `${SITE}/media/category/${slug}`;

/** トップ（Blog）・記事（Article）と揃える。表示しているパンくずと同じ階層を出す。 */
const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${categoryUrl}#collection`,
  name: axis.name,
  description,
  url: categoryUrl,
  inLanguage: 'ja',
  isPartOf: { '@type': 'Blog', '@id': `${SITE}/media#blog`, name: '記念日のヒント' },
  publisher: { '@type': 'Organization', name: 'Anniv', url: `${SITE}/` },
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Anniv', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'メディア', item: `${SITE}/media` },
    { '@type': 'ListItem', position: 3, name: axis.name, item: categoryUrl },
  ],
};
---

<MediaLayout title={title} description={description} current="media" noindex={total === 0}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(collectionLd)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)} />
  </Fragment>

  <div class="shell shell-media">
    <nav class="art-crumb" aria-label="パンくず">
      <a href="/">ホーム</a><span class="sep">›</span>
      <a href="/media">メディア</a><span class="sep">›</span>
      <span aria-current="page">{axis.name}</span>
    </nav>

    <header class="section-header">
      <p class="section-label">CATEGORY</p>
      <h1 class="section-title">{axis.name}</h1>
      <p class="section-sub">
        {axis.description}
        {total > 0 && <Fragment>現在{total}件の記事があります。</Fragment>}
      </p>
    </header>

    <nav class="axis-filter" aria-label="カテゴリ">
      <a class="axis-pill" href="/media">すべて</a>
      {
        AXES.map((a) => (
          <a
            class="axis-pill"
            href={`/media/category/${a.slug}`}
            aria-current={a.slug === slug ? 'page' : undefined}
          >
            {a.name}
          </a>
        ))
      }
    </nav>

    <div class="m-layout">
      <div class="m-main">
        {
          articles.length === 0 ? (
            <p class="empty">
              この軸の記事は準備中です。
              <br />
              <a href="/media">ほかの記事を見る</a>
            </p>
          ) : (
            <div class="card-grid">
              {articles.map((a) => (
                <ArticleCard article={a} />
              ))}
            </div>
          )
        }

        <aside class="m-inline-cta">
          <p>{axis.description}お困りのことがあれば、その場でご相談いただけます。</p>
          <a
            href="https://anniv.gift/contact"
            data-cta="form"
            data-cta-label={`media_rail_${axis.slug}`}
          >
            無料で相談する
          </a>
        </aside>
      </div>

      <aside class="m-aside">
        {
          popular.length > 0 && (
            <section class="m-side-card">
              <p class="m-side-head">
                POPULAR
                <span class="m-side-head-ja">人気の記事</span>
              </p>
              <ol class="m-rank">
                {popular.map((p) => (
                  <li>
                    <a href={`/media/${p.slug}`}>
                      <span class="m-rank-title">{p.title}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </section>
          )
        }

        <section class="m-side-card m-side-cta">
          <p class="m-side-cta-title">記念日の準備を任せる</p>
          <p class="m-side-cta-text">
            プレゼント選びからお店の予約、当日の演出まで。関係性と予算に合わせてお手伝いします。
          </p>
          <a href="https://anniv.gift/contact" data-cta="form" data-cta-label="media_side"
            >無料で相談する</a
          >
        </section>

        {/* トップと同じ「更新を受け取る」カード。計測は follow_click（計測設計.md 4章）。 */}
        <nav class="m-side-card" aria-label="更新情報">
          <p class="m-side-head">
            FEED
            <span class="m-side-head-ja">更新を受け取る</span>
          </p>
          <div class="m-side-nav">
            <a href="/media/feed.xml" data-follow="rss">RSSで購読する</a>
            <a
              href="https://www.instagram.com/anniv.gift/"
              target="_blank"
              rel="noopener noreferrer"
              data-follow="instagram">Instagram</a
            >
            <a
              href="https://x.com/Anniv_gift"
              target="_blank"
              rel="noopener noreferrer"
              data-follow="x">X</a
            >
          </div>
        </nav>
      </aside>
    </div>

    <aside class="list-cta">
      <div>
        <p class="list-cta-title">記念日の準備に迷ったら</p>
        <p class="list-cta-text">
          プレゼント選び・お店の予約・当日の演出まで、まるごとご相談いただけます。予算や希望が固まっていない段階でも大丈夫です。
        </p>
      </div>
      <div class="list-cta-actions">
        <a href="https://anniv.gift/contact" class="cta-btn" data-cta="form" data-cta-label="media_list">無料で相談する</a>
        <a
          href="https://lin.ee/U4deTzi"
          class="cta-btn cta-btn-line"
          target="_blank"
          rel="noopener noreferrer"
          data-cta="line"
          data-cta-label="media_list">LINEで相談する</a
        >
      </div>
    </aside>
  </div>
</MediaLayout>
