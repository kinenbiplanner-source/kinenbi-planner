---
/**
 * メディアのトップ（1ページ目）。2ページ目以降は /media/page/<n> が受ける。
 * 1ページ目を /media/page/1 にも出すと同じ内容が2つのURLで出るので、あちらは /media へ 301 する。
 *
 * 構成は apptime.co.jp/media/ を参照：
 *   検索バー＋タグ → 軸ごとの横スクロールレール（＋直後にCTA）→ 新着グリッド ＋ 右サイドバー
 * 「まず軸で見せてから全件」にすることで、記事が少ないうちでもトップが
 * 「何を扱うメディアか」を説明する面になる（メディア戦略.md 3章の着手順と対）。
 *
 * 記事が1本も無い軸はレールに出せないので、下の「このメディアで扱うテーマ」で受ける。
 * 立ち上げ期はこれが3枚とも出る状態が続く前提で、**記事0本でもトップが白紙にならない**
 * ようにしてある。記事が入った軸は自動でレール側へ移り、カードは消える。
 */
export const prerender = false;

import MediaLayout from '../../layouts/MediaLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { AXES, type AxisSlug } from '../../lib/axis';
import { listPublished, countPublished, listPopular, db, PAGE_SIZE } from '../../lib/db';

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=86400');

const SITE = 'https://anniv.gift';

/** 軸レールの表示件数。横スクロールなので画面幅に収まる必要はない。 */
const RAIL_SIZE = 6;

/**
 * 「タグから探す」に出すキーワード。
 * 手で決め打ちにすると記事が無いタグが残るので、公開記事が実際に狙っている
 * KW（articles.keyword）から拾って検索へ繋ぐ。db.ts は編集できないのでここで引く。
 */
async function tagKeywords(limit = 6): Promise<string[]> {
  const { results } = await db()
    .prepare(
      `SELECT keyword FROM articles WHERE status='published' AND keyword <> ''
       GROUP BY keyword ORDER BY MAX(published_at) DESC LIMIT ?`,
    )
    .bind(limit)
    .all<{ keyword: string }>();
  return (results ?? []).map((r) => r.keyword);
}

/**
 * 軸ごとの公開記事数。セクション見出しの「すべて見る」に添える。
 * レールは RAIL_SIZE で切っているので items.length では総数にならない。
 * 軸ごとに COUNT を投げると3往復になるので1本にまとめる。
 */
async function countsByAxis(): Promise<Record<string, number>> {
  const { results } = await db()
    .prepare(`SELECT axis, COUNT(*) AS n FROM articles WHERE status='published' GROUP BY axis`)
    .all<{ axis: string; n: number }>();
  return Object.fromEntries((results ?? []).map((r) => [r.axis, r.n]));
}

// 軸レールは Promise.all を入れ子にする。展開して1本の配列にすると
// 戻り値の型が union になり、以降の型が効かなくなる。
const [total, articles, popularAll, keywords, axisCounts, rails] = await Promise.all([
  countPublished(),
  listPublished({ limit: PAGE_SIZE }),
  listPopular(30, 5),
  tagKeywords(),
  countsByAxis(),
  Promise.all(AXES.map((a) => listPublished({ axis: a.slug, limit: RAIL_SIZE }))),
]);

// listPopular は PV が 0 の記事も新しい順で埋めて返す。
// PVが1件も付いていないうちにそれを並べると「読まれていない記事を人気として出す」
// ことになるので落とす。全部落ちればカードごと出ない（表示側で length を見ている）。
const popular = popularAll.filter((p) => p.pv > 0);

// 記事が1本も無い軸。レールに出せないぶんを下のテーマカードで受ける。
const emptyAxes = AXES.filter((_, i) => (rails[i] ?? []).length === 0);

const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));

/** 軸レール直後のCTA。軸ごとに言い回しを変えて、直前の話題から地続きにする。 */
const RAIL_CTA: Record<AxisSlug, string> = {
  gift: 'プレゼントの候補が絞りきれないときは、関係性と予算からご一緒に考えます。',
  date: 'お店探しから予約の連絡まで、記念日当日の段取りごとお任せいただけます。',
  concierge: '何をどこまで任せられるか、費用感を含めて無料でご相談いただけます。',
};

const title = '記念日のヒント | Anniv';
const description =
  'プレゼント選びから記念日デートのお店選び、当日のサプライズ演出まで。記念日を成功させるための考え方と段取りをまとめた、Annivのメディアです。';

/**
 * 構造化データ。記事ページ（MediaArticle.astro）が Article ＋ BreadcrumbList を出しているのに
 * 一覧の親であるここが無いと、メディア全体が1つの Blog として繋がらないので揃えておく。
 * blogPost は新着グリッドに出している分だけ。載っていない記事まで並べても実体と合わない。
 */
const blogLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  '@id': `${SITE}/media#blog`,
  name: '記念日のヒント',
  description,
  url: `${SITE}/media`,
  inLanguage: 'ja',
  publisher: { '@type': 'Organization', name: 'Anniv', url: `${SITE}/` },
  ...(articles.length > 0
    ? {
        blogPost: articles.map((a) => ({
          '@type': 'BlogPosting',
          headline: a.title,
          description: a.description,
          url: `${SITE}/media/${a.slug}`,
          ...(a.published_at ? { datePublished: a.published_at } : {}),
        })),
      }
    : {}),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Anniv', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'メディア', item: `${SITE}/media` },
  ],
};
---

<MediaLayout title={title} description={description} current="media">
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(blogLd)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)} />
  </Fragment>

  <div class="shell shell-media">
    {/* カテゴリ・記事と同じ形のパンくず。トップだけ無いと構造化データと表示がズレる。 */}
    <nav class="art-crumb" aria-label="パンくず">
      <a href="/">ホーム</a><span class="sep">›</span>
      <span aria-current="page">メディア</span>
    </nav>

    <header class="section-header">
      <p class="section-label">MEDIA</p>
      <h1 class="section-title">記念日のヒント</h1>
      <p class="section-sub">
        プレゼント選びから当日の演出まで、記念日を成功させるための考え方をまとめています。
      </p>
    </header>

    {/* 検索とタグ。ヘッダー（Nav.astro）は LP と共通なので、探す導線はここに置く。 */}
    <section class="findbar" aria-label="記事を探す">
      <form class="findbar-form" action="/media/search" method="get" role="search">
        <input
          class="findbar-input"
          type="search"
          name="q"
          placeholder="記念日、プレゼント、レストラン…"
          aria-label="記事を検索"
        />
        <button class="findbar-submit" type="submit">探す</button>
      </form>
      <div class="findbar-tags">
        <span class="findbar-tags-label">タグから探す</span>
        {
          AXES.map((a) => (
            <a class="findbar-tag is-axis" href={`/media/category/${a.slug}`}>
              {a.short}
            </a>
          ))
        }
        {
          /* 検索結果は noindex。クロールを送り込んでも拾われないので nofollow を付ける。
             人が使う導線としてはそのまま残す。 */
          keywords.map((k) => (
            <a class="findbar-tag" rel="nofollow" href={`/media/search?q=${encodeURIComponent(k)}`}>
              {k}
            </a>
          ))
        }
      </div>
    </section>

    <div class="m-layout">
      <div class="m-main">
        {
          /* 軸セクション。記事が1本も無い軸はレールが空になるだけなので、
             ここでは出さず下の「このメディアで扱うテーマ」に回す。 */
          AXES.map((axis, i) => {
            const items = rails[i] ?? [];
            if (items.length === 0) return null;
            const n = axisCounts[axis.slug] ?? items.length;
            return (
              <section class="m-sec">
                <div class="m-sec-head">
                  <div>
                    <h2 class="m-sec-title">{axis.name}</h2>
                    <p class="m-sec-desc">{axis.description}</p>
                  </div>
                  <a class="m-sec-more" href={`/media/category/${axis.slug}`}>
                    すべて見る（{n}件）
                  </a>
                </div>

                {/* 横スクロール領域。カード以外の場所からキーボードでも送れるよう
                    グループとして名前を付けておく（マウスホイール以外の手段が要る）。 */}
                <div class="m-rail" role="group" aria-label={`${axis.name}の記事`}>
                  {items.map((a) => (
                    <ArticleCard article={a} headingLevel={3} />
                  ))}
                </div>

                <aside class="m-inline-cta">
                  <p>{RAIL_CTA[axis.slug]}</p>
                  <a
                    href="https://anniv.gift/contact"
                    data-cta="form"
                    data-cta-label={`media_rail_${axis.slug}`}
                  >
                    無料で相談する
                  </a>
                </aside>
              </section>
            );
          })
        }

        {
          /* 新着グリッド。記事が0本のときは「準備中です」の箱を置くより、
             下のテーマカードに面を譲ったほうがトップが説明として成立する。 */
          total > 0 && (
            <section class="m-sec">
              <div class="m-sec-head">
                <div>
                  <h2 class="m-sec-title">新着の記事</h2>
                  <p class="m-sec-desc">公開したものから順に並べています。</p>
                </div>
                <span class="m-sec-count">全{total}件</span>
              </div>

              <div class="card-grid">
                {articles.map((a) => (
                  <ArticleCard article={a} headingLevel={3} />
                ))}
              </div>

              {totalPages > 1 && (
                <nav class="pager" aria-label="ページ送り">
                  <span class="is-disabled">前へ</span>
                  {Array.from({ length: totalPages }, (_, i) => i + 1).map((n) =>
                    n === 1 ? (
                      <span class="is-current" aria-current="page">
                        {n}
                      </span>
                    ) : (
                      <a href={`/media/page/${n}`}>{n}</a>
                    ),
                  )}
                  <a href="/media/page/2">次へ</a>
                </nav>
              )}
            </section>
          )
        }

        {
          /* まだ記事の無い軸。ここが「このメディアは何を扱うのか」を伝える面になる。
             中身の無いカテゴリページへ送っても得るものが無いのでリンクにはしない。 */
          emptyAxes.length > 0 && (
            <section class="m-sec">
              <div class="m-sec-head">
                <div>
                  <h2 class="m-sec-title">このメディアで扱うテーマ</h2>
                  <p class="m-sec-desc">
                    記念日の準備を3つの軸に分けて、順に記事を公開していきます。
                  </p>
                </div>
              </div>

              <div class="m-topics">
                {emptyAxes.map((a) => (
                  <article class="m-topic">
                    <h3 class="m-topic-name">{a.name}</h3>
                    <p class="m-topic-desc">{a.description}</p>
                    <span class="m-topic-soon">記事は準備中です</span>
                  </article>
                ))}
              </div>
            </section>
          )
        }
      </div>

      <aside class="m-aside">
        {
          /* 直近30日のPVが多い順。PV0のものは上で落としてあるので、
             ここに並ぶのは実際に読まれている記事だけ。 */
          popular.length > 0 && (
            <section class="m-side-card">
              <p class="m-side-head">
                POPULAR
                <span class="m-side-head-ja">人気の記事</span>
              </p>
              <ol class="m-rank">
                {popular.map((p) => (
                  <li>
                    <a href={`/media/${p.slug}`}>
                      <span class="m-rank-title">{p.title}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </section>
          )
        }

        <section class="m-side-card m-side-cta">
          <p class="m-side-cta-title">記念日の準備を任せる</p>
          <p class="m-side-cta-text">
            プレゼント選びからお店の予約、当日の演出まで。関係性と予算に合わせてお手伝いします。
          </p>
          <a href="https://anniv.gift/contact" data-cta="form" data-cta-label="media_side"
            >無料で相談する</a
          >
        </section>

        {/*
          「CATEGORY」と「FEED（更新を受け取る）」のカードはここに置かない。
          カテゴリは同じページの上（findbar のタグ）と各レールの「もっと見る」で
          既に2回出ていて、3つ目のリンクは情報を足していない。
          RSSは BaseHead の <link rel="alternate"> でリーダーから辿れるので、
          本文の横に置く必要が無い。SNSはフッターに常設（計測は data-follow で継続）。
        */}
      </aside>
    </div>

    <aside class="list-cta">
      <div>
        <p class="list-cta-title">記念日の準備に迷ったら</p>
        <p class="list-cta-text">
          プレゼント選び・お店の予約・当日の演出まで、まるごとご相談いただけます。予算や希望が固まっていない段階でも大丈夫です。
        </p>
      </div>
      <div class="list-cta-actions">
        <a href="https://anniv.gift/contact" class="cta-btn" data-cta="form" data-cta-label="media_list">無料で相談する</a>
        <a
          href="https://lin.ee/U4deTzi"
          class="cta-btn cta-btn-line"
          target="_blank"
          rel="noopener noreferrer"
          data-cta="line"
          data-cta-label="media_list">LINEで相談する</a
        >
      </div>
    </aside>
  </div>
</MediaLayout>
