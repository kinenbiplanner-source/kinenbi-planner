---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';

const posts = (await getCollection('media', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

const fmt = (d: Date) =>
  new Intl.DateTimeFormat('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' }).format(d);

const title = '記念日メディア | Anniv';
const description =
  'プレゼント選び・記念日デート・サプライズ演出の考え方をまとめた、Annivの記念日ガイド。相場や選び方の判断軸から、当日の段取りまで。';
---

<!doctype html>
<html lang="ja">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="site-logo">Anniv</a>
      <nav>
        <a href="/media">メディア</a>
        <a href="https://anniv.gift/contact.html" class="header-cta">無料相談</a>
      </nav>
    </header>

    <main>
      <div class="page-label">Media</div>
      <h1>記念日ガイド</h1>
      <p class="lead">
        プレゼント選び、記念日のお店選び、サプライズの段取り。迷いやすいところを、判断軸から整理しています。
      </p>

      {
        posts.length === 0 ? (
          <p class="empty">記事の準備中です。</p>
        ) : (
          <ul class="post-list">
            {posts.map((post) => (
              <li>
                <a href={`/media/${post.id}`}>
                  <div class="post-meta">
                    <span class="badge">{post.data.axis}</span>
                    <time datetime={post.data.publishDate.toISOString()}>
                      {fmt(post.data.publishDate)}
                    </time>
                  </div>
                  <h2>{post.data.title}</h2>
                  <p>{post.data.description}</p>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </main>

    <footer class="site-footer">
      <div class="footer-links">
        <a href="/tokutei.html">特定商取引法に基づく表記</a>
        <a href="/privacy.html">プライバシーポリシー</a>
        <a href="/contact.html">お問い合わせ</a>
      </div>
      <div>© 2026 Anniv</div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --navy: #1a2840;
    --blue-mid: #4a8ab5;
    --gold: #c4a35a;
    --text: #2d3748;
    --text-light: #64748b;
    --border: #d1e8f5;
    --ivory: #fafaf8;
    --font-serif-jp: 'Cormorant Garamond', 'Noto Serif JP', serif;
  }
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }
  body {
    font-family: 'Noto Sans JP', sans-serif;
    color: var(--text);
    background: #fff;
    line-height: 1.9;
  }
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 28px;
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(12px);
    z-index: 10;
  }
  .site-logo {
    font-family: var(--font-serif-jp);
    font-size: 1.6rem;
    font-weight: 600;
    color: var(--navy);
    text-decoration: none;
    letter-spacing: 0.05em;
  }
  .site-header nav {
    display: flex;
    gap: 20px;
    align-items: center;
  }
  .site-header nav a {
    color: var(--text-light);
    text-decoration: none;
    font-size: 0.94rem;
  }
  .header-cta {
    background: var(--navy);
    color: #fff !important;
    padding: 9px 18px;
    border-radius: 8px;
  }
  main {
    max-width: 820px;
    margin: 0 auto;
    padding: 48px 24px 80px;
  }
  .page-label {
    font-family: var(--font-serif-jp);
    font-size: 0.9rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 10px;
  }
  h1 {
    font-size: 2.1rem;
    color: var(--navy);
    margin-bottom: 14px;
  }
  .lead {
    color: var(--text-light);
    margin-bottom: 44px;
  }
  .empty {
    color: var(--text-light);
    padding: 40px 0;
  }
  .post-list {
    list-style: none;
    display: grid;
    gap: 18px;
  }
  .post-list a {
    display: block;
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .post-list a:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(26, 40, 64, 0.09);
  }
  .post-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.8rem;
    color: var(--text-light);
    margin-bottom: 10px;
  }
  .badge {
    padding: 3px 11px;
    border-radius: 999px;
    background: #f0f7fc;
    color: var(--blue-mid);
    border: 1px solid var(--border);
  }
  .post-list h2 {
    font-size: 1.24rem;
    color: var(--navy);
    line-height: 1.6;
    margin-bottom: 8px;
  }
  .post-list p {
    font-size: 0.92rem;
    color: var(--text-light);
    line-height: 1.8;
  }
  .site-footer {
    border-top: 1px solid var(--border);
    padding: 28px 24px;
    text-align: center;
    font-size: 0.84rem;
    color: var(--text-light);
  }
  .footer-links {
    display: flex;
    gap: 18px;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 10px;
  }
  .footer-links a {
    color: var(--text-light);
    text-decoration: none;
  }
  @media (max-width: 640px) {
    h1 {
      font-size: 1.6rem;
    }
    main {
      padding: 32px 18px 60px;
    }
  }
</style>
